<mujoco>
    <!--
        Neutral assembly for the July-2026 meshes.

        Mesh-local frames are used directly: no geom translation or rotation is
        applied.  The only body translations below are joint-centre/link-length
        offsets required by the kinematic tree.  All joint reference angles are
        zero.  Local x points radially outwards, local y is the finger hinge axis,
        and local z is vertical in the unrotated module frame.

        Each linear-module body is a direct child of root and rotates about its
        own local x axis.  The armbase is its translating child and has only a
        local-z slide.  Consequently the slide direction rotates together with
        the linear module.  qpos=0 is the current assembled pose; qpos=-0.05
        translates the armbase 50 mm along the rotated local -z direction.

        For backward-compatible actuator indices, the historical joint names
        are retained: armbase_joint_* is the x hinge on linear_*, while
        linear_joint_* is the z slide on armbase_*.

        gravcomp=1 is explicit on every gripper body so its mass is gravity
        compensated without disabling gravity for the free object or table.
    -->
    <body name="root" pos="0 0 0.525" quat="1 0 0 0" gravcomp="1">
        <geom name="body_module" type="mesh" class="root_collision"
              rgba="0.5 0.5 0.8 1" mesh="body_module_mujoco"/>

        <!-- Right module: local +x points towards world +x. -->
        <body name="robot0:linear_R" pos="0.066 0 0.0365" quat="1 0 0 0" gravcomp="1">
            <joint name="robot0:armbase_joint_R" class="dynamixel_xc430"
                   type="hinge" axis="1 0 0" range="-1.396263402 1.396263402"/>
            <geom name="linear_R" type="mesh" class="visual"
                  rgba="0.35 0.35 0.40 1" mesh="linear_module_mujoco"/>

            <body name="robot0:armbase_R" pos="0.04623106 0 0.04796355" gravcomp="1">
                <joint name="robot0:linear_joint_R" class="linear_slide"
                       type="slide" axis="0 0 1" range="-0.05 0"/>
                <geom name="armbase_R" type="mesh" class="visual"
                      rgba="0.6 0.6 0.6 1" mesh="armbase_module_mujoco"/>

            <body name="robot0:back_R" pos="0.04585312 0.019 -0.02721083" quat="0.988361510468 0 0.15212338619 0" gravcomp="1">
                <joint name="robot0:back_joint_R" class="dynamixel_xc430"
                       type="hinge" axis="0 1 0" range="-2.007128640 1.047197551"/>
                <geom name="back_R" class="arm_link" rgba="1 0.6 0.15 1" mesh="backbased_mujoco"/>
                <body name="robot0:short_R" pos="0.061 -0.0165 0" gravcomp="1">
                    <joint name="robot0:short_joint_R" class="passive_short"
                           type="hinge" axis="0 1 0" range="0 2.356194490"/>
                    <geom name="short_R" class="arm_link" rgba="1 0.6 0.15 1" mesh="short"/>
                    <body name="robot0:long_R" pos="0.072 0.0005 0" quat="0.957184002665 0 0.289480198013 0" gravcomp="1">
                        <joint name="robot0:elbow_joint_R" class="passive_elbow"
                               type="hinge" axis="0 1 0" range="-2.129301687 0.523598776"/>
                        <geom name="long_R" class="arm_link" rgba="1 0.6 0.15 1" mesh="long"/>
                        <site name="pin:R_long" pos="0 -0.0005 -0.06676632" size="0.002" rgba="1 1 0 0"/>
                        <body name="hard_tip_R" pos="-0.0422601 -0.003 -0.25418531" gravcomp="1">
                            <geom name="hard_tip_R" class="Hard_tip" type="sphere"
                                  size="0.016" rgba="1 0 0 1"/>
                        </body>
                    </body>
                </body>
            </body>

            <body name="robot0:front_R" pos="0.02929162 0.019 -0.08021268" quat="0.988361510468 0 0.15212338619 0" gravcomp="1">
