<?xml version="1.0" encoding="utf-8"?>
<mujoco model="gripper3_mjwarp_rl_rotate_banana">
    <!-- One-object MJWarp shard: nq=27, nv=26, nu=12. -->
    <compiler angle="radian" meshdir="mesh" balanceinertia="true"
              discardvisual="false" autolimits="true"/>
    <option timestep="0.0005" solver="Newton" jacobian="dense"
            iterations="150" ls_iterations="20" tolerance="1e-10">
        <flag warmstart="enable" multiccd="disable"/>
    </option>

    <include file="G3_Share.xml"/>
    <include file="G3_ObjectAssets.xml"/>

    <worldbody>
        <geom name="floor" pos="0 0 -0.1" size="15 15 1"
              type="plane" material="matplane" margin="0.001"
              condim="3" friction="1 0.005 0.0001"
              contype="0" conaffinity="0"/>
        <include file="G3_Gripper_rotate.xml"/>
        <body name="table" pos="0 0 0.25">
            <geom name="table_geom" type="box" class="platform"
                  size="0.5 0.5 0.01" rgba="0.70 0.70 0.70 1"
                  friction="1 0.005 0.0001"/>
        </body>
        <body name="object_banana" pos="1.40 0 0.260">
            <joint name="joint:object_banana" type="free" damping="0.012"/>
            <inertial pos="0 0 0.0175339" mass="0.066"
                      diaginertia="0.000182556 0.000072699 0.000240405"/>
            <geom name="object_banana_visual" class="visual"
                  type="mesh" mesh="object_ycb_banana_mesh"
                  pos="0.009936102 -0.004072679 0.000407"
                  material="object_ycb_banana_material"/>
            <include file="fruit_capsules_5mm_banana.xml"/>
            <site name="object_banana_reference" pos="0 0 0.0175339"
                  size="0.002" rgba="1 1 1 0"/>
        </body>
        <light directional="true" diffuse="0.3 0.3 0.3"
               specular="0.3 0.3 0.3" castshadow="true"
               pos="0.1 0.1 0.1" dir="0.2 0.1 -0.1"/>
    </worldbody>
</mujoco>
