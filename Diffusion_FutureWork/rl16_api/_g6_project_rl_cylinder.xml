<?xml version="1.0" encoding="utf-8"?>
<mujoco model="gripper6_ik_grab_rl_cylinder_dense_newton">
    <!-- Training-only single-object MJWarp model. -->
    <compiler angle="radian" meshdir="mesh" texturedir="mesh"
              balanceinertia="true"
              discardvisual="false" autolimits="true"/>
    <option timestep="0.0005" solver="Newton" jacobian="dense"
            iterations="150" ls_iterations="20" tolerance="1e-10">
        <flag warmstart="enable" multiccd="disable"/>
    </option>

    <include file="_g6_share.xml"/>

    <worldbody>
        <geom name="floor" pos="0 0 -0.1" size="15 15 1"
              type="plane" material="matplane" margin="0.001"
              condim="3" friction="1 0.005 0.0001"
              contype="0" conaffinity="0"/>
        <include file="_g6_gripper.xml"/>
        <body name="table" pos="0 0 0.25">
            <geom name="table_geom" type="box" class="platform"
                  size="0.5 0.5 0.01" rgba="0.70 0.70 0.70 1"
                  friction="1 0.005 0.0001"/>
        </body>
        <body name="object_cylinder" pos="1.20 0 0.310">
            <joint name="joint:object_cylinder" type="free" damping="0.05"/>
            <inertial pos="0 0 0" mass="0.200"
                      diaginertia="0.0001979166 0.0001979166 0.0000625000"/>
            <geom name="object_cylinder_geom" class="grasp_object"
                  type="cylinder" size="0.025 0.050"
                  rgba="0.20 0.55 0.95 1"/>
            <site name="object_cylinder_reference" pos="0 0 0" size="0.002"
                  rgba="1 1 1 0"/>
        </body>
        <light directional="true" diffuse="0.3 0.3 0.3"
               specular="0.3 0.3 0.3" castshadow="true"
               pos="0.1 0.1 0.1" dir="0.2 0.1 -0.1"/>
    </worldbody>
</mujoco>
