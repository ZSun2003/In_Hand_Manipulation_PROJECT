#!/usr/bin/env bash
#PBS -N screw_cx3_capacity_8192
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -r y
#PBS -S /bin/bash

set -euo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"
# shellcheck source=_common.sh
source "${SUBMIT_DIR}/jobs/_common.sh"
screw_hpc_init
export WARP_CACHE_PATH="${SCREW_HPC_ROOT}/.cache/warp_8192"
mkdir -p "${WARP_CACHE_PATH}"

CONFIG="${SCREW_HPC_ROOT}/configs/cx3_l40s_8192.json"
screw_require_file "${SCREW_HPC_ROOT}/capacity_probe.py"
screw_require_file "${CONFIG}"

JOB_TAG="$(screw_job_tag)"
RUN_DIR="${SCREW_HPC_ROOT}/runs/cx3_capacity_8192_${JOB_TAG}"
export SCREW_SYSTEM_INTERVAL=2
export SCREW_SYSTEM_HISTORY_INTERVAL=2
screw_start_live_monitor "${RUN_DIR}"
screw_record_job \
  "${RUN_DIR}" running "" \
  "Aggressive L40S sweep: 1024, 2048, 4096, and 8192 MJWarp worlds."

"${SCREW_PYTHON}" "${SCREW_HPC_ROOT}/capacity_probe.py" \
  --config "${CONFIG}" \
  --run-dir "${RUN_DIR}" \
  --worlds 1024 2048 4096 8192 \
  --require-worlds 8192

screw_record_job \
  "${RUN_DIR}" completed 0 \
  "Aggressive CX3 L40S 8192-world capacity gate passed."
printf 'Aggressive capacity qualification completed: %s\n' "${RUN_DIR}"
